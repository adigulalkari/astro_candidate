# Example backend environment variables for local development (backend/.env.example)
# Copy to backend/.env for local development and DO NOT commit backend/.env to the repo.

# Optional: frontend origin to allow in CORS (used by backend/main.py)
FRONTEND_URL=https://<your-vercel-project>.vercel.app

# Example other vars you must set on Render (do NOT commit secrets):
# OPENAI_API_KEY=
# NEO4J_URI=
# NEO4J_USERNAME=
# NEO4J_PASSWORD=
