# Example frontend environment variables for Vite (frontend/.env.example)
# Copy this file to frontend/.env for local development and DO NOT commit frontend/.env to the repo.

# URL of the backend (deployed on Render). Replace with your Render service URL.
VITE_API_BASE_URL=https://eca-backend.onrender.com

# For local development use:
# VITE_API_BASE_URL=http://localhost:8000
